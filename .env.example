# HTTP + WebSocket service
PORT=8080
# The frontend proxies /api/* here; cookies and the Google redirect use this origin.
FRONTEND_URL=http://localhost:3000

# PostgreSQL (migrations and all application persistence run here)
DATABASE_URL=

# Long random values. AUTH_SECRET signs browser sessions; ROOM_TOKEN_SECRET
# signs short-lived WebSocket room tokens.
AUTH_SECRET=
ROOM_TOKEN_SECRET=

# Google Cloud OAuth web application. Its authorised redirect URI must be:
# http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
